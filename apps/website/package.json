{
  "name": "@discord-player/website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --workspace-root run docs:api && next build && node scripts/verify-social-images.mjs && node scripts/check-links.mjs && pnpm --workspace-root run docs:verify-export",
    "verify:og": "node scripts/verify-social-images.mjs",
    "dev": "pnpm --workspace-root run docs:api && next dev",
    "start": "serve out",
    "typecheck": "pnpm --workspace-root run docs:api && next typegen && tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.10",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "29.0.1",
    "oxlint": "catalog:",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
