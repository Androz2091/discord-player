DISCORD_TOKEN="bot-token-here"

# Optional directory searched by /play for local music files.
MUSIC_DIRECTORY=""

# Select embedded (default) or remote Remedia.
REMEDIA_MODE=embedded
# Required only for REMEDIA_MODE=remote. Use TLS outside localhost.
# REMEDIA_URL=remedias://audio.example.com
# REMEDIA_USERNAME=bot
# REMEDIA_PASSWORD=replace-with-a-long-secret

# Automatic PCM crossfades for normal /play queues (remote servers must also enable support).
REMEDIA_CROSSFADE=false
REMEDIA_CROSSFADE_DURATION_MS=5000
