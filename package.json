{
  "name": "@discord-player/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Discord Player Monorepo",
  "homepage": "https://github.com/Androz2091/discord-player#readme",
  "bugs": {
    "url": "https://github.com/Androz2091/discord-player/issues"
  },
  "license": "MIT",
  "author": "Androz2091",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Androz2091/discord-player.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "pnpm --recursive --if-present run typecheck && pnpm docs:typecheck",
    "build": "pnpm --recursive --if-present --filter '!./apps/website' --filter '!./apps/music-bot' run build",
    "test": "pnpm --recursive --if-present run test && node --test .github/scripts/*.test.mjs && pnpm docs:test",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "docs:api": "node scripts/docs/generate.ts",
    "docs:typecheck": "tsc -p scripts/docs/tsconfig.json",
    "docs:test": "node --test scripts/docs/tests/*.test.ts",
    "docs:verify-export": "node scripts/docs/verify-export.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typedoc": "0.28.20",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.16.1"
}
