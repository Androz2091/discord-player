{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.source/**",
    "**/generated/**",
    "packages/remedia-node/native.js",
    "packages/remedia-node/native.d.ts",
    "**/*.generated.js",
    "**/*.generated.jsx",
    "**/*.generated.ts",
    "**/*.generated.tsx",
    "Cargo.lock",
    "pnpm-lock.yaml"
  ]
}
